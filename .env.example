# Copy to .env and adjust. .env is gitignored. Never commit real values.
# Every variable the application reads is listed here with a placeholder.

# Email address allowed to run first setup. Setup creates the household and its first
# member and maps this email to that member (ADR-0024). Only used while no household
# exists.
IASION_SETUP_EMAIL=first.member@example.com

# Cloudflare Access (ADR-0037). The team domain issues the tokens; the AUD tag is the
# application's audience. Both come from the Access configuration of the instance.
IASION_ACCESS_TEAM_DOMAIN=example-team.cloudflareaccess.com
IASION_ACCESS_AUD=00000000000000000000000000000000

# The origin the app is served from. Requests other than GET must carry this Origin
# header (ADR-0037).
IASION_PUBLIC_ORIGIN=https://iasion.example.com

# Where the Access public keys are fetched from. Leave it empty on an instance: it
# defaults to the team domain's /cdn-cgi/access/certs endpoint. The value below is
# the access-dev service of compose.yaml, for development (ADR-0038).
IASION_ACCESS_CERTS_URL=http://localhost:8790/certs

# Where the app listens, and the health check on the loopback interface only, which
# `iasion health` asks (ADR-0040). Both optional; these are the defaults.
IASION_LISTEN_ADDR=0.0.0.0:8080
IASION_HEALTH_ADDR=127.0.0.1:8081

# The built frontend that the app serves (ADR-0043). Optional; web/dist by default,
# relative to the working directory.
IASION_WEB_DIR=web/dist

# Database (ADR-0033, ADR-0038). Placeholder values; each instance sets its own.
# Application role: SELECT and INSERT on identity and version tables.
IASION_DATABASE_URL=postgres://iasion_app:placeholder@localhost:5432/iasion
# Owner role: runs migrations (`migrate` subcommand).
IASION_MIGRATE_DATABASE_URL=postgres://iasion_owner:placeholder@localhost:5432/iasion

# Passwords of the two roles, used once to create them (deploy/postgres/init-roles.sh).
# They must match the passwords in the two URLs above.
IASION_DB_OWNER_PASSWORD=placeholder
IASION_DB_APP_PASSWORD=placeholder

# Development and CI only. Superuser password of the dev database container, and the
# superuser connection that #[sqlx::test] and `cargo sqlx prepare` need.
POSTGRES_PASSWORD=placeholder
DATABASE_URL=postgres://postgres:placeholder@localhost:5432/iasion

# Development only (ADR-0044). Set to 1 where `./dev up` does not notice changes to the
# code, as with some Docker Desktop file sharing: the app's services then poll instead.
IASION_DEV_POLL=

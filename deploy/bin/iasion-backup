#!/bin/sh
# Backs up the database (ADR-0040, decisions 12 and 13): a pg_dump through the database
# container, encrypted and copied off the VM with restic, to the repository set in
# /etc/iasion/restic.env. Usage: iasion-backup nightly | pre-migrate
#
# Nightly backups keep 7 daily, 4 weekly and 12 monthly snapshots; the ones taken
# before migrations are kept for 30 days. Before migrating, a backup is taken only if a
# migration is pending: most starts of the app migrate nothing, and a backup that is
# not needed must not delay or block them. The newest dumps also stay on the VM for
# three days, for a quick restore.
set -eu

kind=${1:-}
case "$kind" in
    nightly | pre-migrate) ;;
    *) echo "usage: iasion-backup nightly | pre-migrate" >&2; exit 2 ;;
esac

RESTIC_IMAGE=docker.io/restic/restic:0.20.0
DUMPS=/var/lib/iasion/backups
SETTINGS=/etc/iasion/restic.env

restic() {
    podman run --rm --network host --env-file "$SETTINGS" --hostname iasion \
        --volume "$DUMPS:/backups:ro" \
        --volume /var/lib/iasion/restic:/var/lib/iasion/restic \
        --volume /var/cache/iasion/restic:/root/.cache/restic \
        "$RESTIC_IMAGE" "$@"
}

if [ "$kind" = pre-migrate ]; then
    # The image the migrate unit is about to run, asked with the same network and role.
    image=$(sed -n 's/^IASION_IMAGE=//p' /etc/iasion/iasion.env | tail -n 1)
    set +e
    podman run --rm --network iasion --read-only --cap-drop all \
        --secret iasion-migrate-database-url,type=env,target=IASION_MIGRATE_DATABASE_URL \
        "$image" migrate --pending
    status=$?
    set -e
    case "$status" in
        0) ;;
        1) echo "iasion-backup: nothing to migrate, so no backup is needed"; exit 0 ;;
        *) echo "iasion-backup: cannot tell whether a migration is pending" >&2; exit 1 ;;
    esac
fi

mkdir -p "$DUMPS" /var/lib/iasion/restic /var/cache/iasion/restic
chmod 700 "$DUMPS"

name="iasion-$(date -u +%Y%m%dT%H%M%SZ)-$kind.dump"
partial="$DUMPS/$name.partial"
# A dump that fails halfway is removed, not left to fill the disk.
trap 'rm -f "$partial"' EXIT
# The custom format is compressed and restores with pg_restore.
podman exec iasion-db pg_dump --username postgres --format custom iasion >"$partial"
mv "$partial" "$DUMPS/$name"
echo "iasion-backup: dumped $name"

restic backup --quiet --tag "$kind" "/backups/$name"
case "$kind" in
    nightly) restic forget --quiet --tag nightly --keep-daily 7 --keep-weekly 4 --keep-monthly 12 --prune ;;
    pre-migrate) restic forget --quiet --tag pre-migrate --keep-within 30d --prune ;;
esac
echo "iasion-backup: $name is in the restic repository"

find "$DUMPS" \( -name 'iasion-*.dump' -o -name 'iasion-*.dump.partial' \) -mtime +3 -delete
